{
  "name": "jord-jd/laravel-route-restrictor",
  "description": "Laravel middleware to restrict a site or specific routes using HTTP basic authentication",
  "keywords": [
    "password",
    "restriction",
    "password restriction",
    "laravel",
    "basic authentication"
  ],
  "homepage": "https://github.com/Jord-JD/laravel-route-restrictor",
  "license": "LGPL-3.0-only",
  "require": {
    "php": ">=5.5.9",
    "laravel/framework": "^5.1||^6.0||^7.0||^8.0||^9.0||^10.0||^11.0||^12.0||^13.0"
  },
  "autoload": {
    "psr-4": {
      "JordJD\\LaravelRouteRestrictor\\": "src/"
    }
  },
  "config": {
    "preferred-install": "dist"
  },
  "extra": {
    "laravel": {
      "providers": [
        "JordJD\\LaravelRouteRestrictor\\Providers\\LaravelRouteRestrictorServiceProvider"
      ]
    },
    "branch-alias": {
      "dev-master": "4.0-dev"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "replace": {
    "divineomega/laravel-route-restrictor": "self.version"
  },
  "require-dev": {
    "phpunit/phpunit": "^4.8||^9.6||^12.0"
  }
}
